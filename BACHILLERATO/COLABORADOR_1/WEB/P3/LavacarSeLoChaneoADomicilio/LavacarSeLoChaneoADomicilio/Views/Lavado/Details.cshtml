@model LavacarSeLoChaneoADomicilio.Models.Lavado
@{
    ViewData["Title"] = "Detalles del Lavado";
}

<h2 class="mb-4">Detalles del Lavado</h2>

<table class="table table-bordered">
    <tr><th>ID</th><td>@Model.Id</td></tr>
    <tr>
        <th>Fecha</th>
        <td>@Model.Fecha.ToString("dd/MM/yyyy HH:mm")</td>
    </tr>
    <tr>
        <th>Vehículo</th>
        <td>
            @if (Model.Vehiculo != null)
            {
                @($"{Model.Vehiculo.Marca} {Model.Vehiculo.Modelo} ({Model.Vehiculo.Placa})")
            }
            else
            {
                @Model.VehiculoPlaca
            }
        </td>
    </tr>
    <tr>
        <th>Cliente</th>
        <td>
            @if (Model.Cliente != null)
            {
                @($"{Model.Cliente.NombreCompleto} ({Model.Cliente.Identificacion})")
            }
            else
            {
                @Model.ClienteId
            }
        </td>
    </tr>
    <tr>
        <th>Empleado</th>
        <td>
            @if (Model.Empleado != null)
            {
                @Model.Empleado.Cedula
            }
            else
            {
                @Model.EmpleadoCedula
            }
        </td>
    </tr>
    <tr>
        <th>Tipo de Lavado</th>
        <td>@Model.Tipo</td>
    </tr>
    <tr>
        <th>Estado</th>
        <td>@Model.Estado</td>
    </tr>
    <tr>
        <th>Precio</th>
        <td>@Model.Precio.ToString("C")</td>
    </tr>
    <tr>
        <th>IVA (13%)</th>
        <td>@Model.IVA.ToString("C")</td>
    </tr>
    <tr>
        <th>Total</th>
        <td><strong>@Model.Total.ToString("C")</strong></td>
    </tr>
</table>

<div class="mt-3">
    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">Editar</a>
    <a asp-action="Index" class="btn btn-secondary">Volver</a>
</div>