0001 program ejemplo_if;
0002 
0003 uses crt;
0004 
0005 var
0006   numero : integer;
0007   
0008 begin
0009   numero := 10;
0010   
0011   // Estructura IF-THEN correcta sin ELSE
0012   if numero > 5 then
0013     begin
0014       writeln('El numero es mayor que 5');
0015       writeln('Esto es un bloque IF correcto');
0016     end
0017     
0018   // Estructura IF-THEN-ELSE correcta
0019   if numero < 20 then
0020     begin
0021       writeln('El numero es menor que 20');
0022       numero := numero + 5;
0023     end
0024   else
0025     begin
0026       writeln('El numero es mayor o igual que 20');
0027       numero := numero - 5;
0028     end;
0029     
0030   // Estructura IF-THEN con errores de tabulación
0031   if numero = 15 then
0032    begin
0033      writeln('El numero es igual a 15')
0034       numero := 0;
0035    end
0036     
0037   // Estructura IF-THEN-ELSE con errores de puntuación
0038   if numero = 0 then
0039     begin
0040       writeln('El numero es cero');
0041     end
0042   else
0043     begin
0044       writeln('El numero no es cero')
0045     end;
0046     
0047   // Estructura IF-THEN sin sentencias (bloque vacío)
0048   if numero < 0 then
0049     begin
0050     end
0051     
0052   writeln('Programa finalizado');
0053 end.
