0008 var dia : integer;
0009 var modulo : integer;
0010 var day : word;
0011 var year : word;
0012 var mes : word;
0013 var dayofweek : word;
0014 
0015 const borde = #205#205#205#205#205#205#205#205#205;    { Error: const después de var }
0016 const months       : array[0..11] of integer = (31, 28, 31, 30, 31, 30, 31, 31, 30, 31, 30, 31);
0017 const year_regular : array[0..11] of integer = ( 0,  3,  3,  6,  1,  4,  6,  2,  5,  0,  3,  5);
0018 const year_bisiesto : array[0..11] of integer = ( 0,  3,  4,  0,  2,  5,  0,  3,  6,  1,  4,  6);
0019 const nombres      : array[0..11] of string  = (
0020     '  Enero   ', ' Febrero  ', '  Marzo   ', '  Abril   ',
0021     '   Mayo   ', '  Junio   ', '  Julio   ', '  Agosto  ',
0022     'Septiembre', ' Octubre  ', 'Noviembre ', 'Diciembre ');
0023 
0024 begin
